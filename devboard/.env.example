# --- Database & Queue ---
DATABASE_URL=postgresql://devboard:devboard@localhost:5432/devboard
REDIS_URL=redis://localhost:6379

# --- GitHub App ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=devboard
# PEM contents, escape newlines as \n if set inline, or point to a file path instead
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- LLM ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Service URLs ---
ANALYZER_URL=http://localhost:8000
API_PORT=3000
ANALYZER_PORT=8000

# --- Integrations (Phase 3) ---
# Slack webhook + Jira token are normally stored encrypted in DB per-repo (see TeamConfig),
# these are only fallback/dev defaults.
SLACK_WEBHOOK_URL=
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# --- Secret management (prod) ---
# In production, do not put real secrets in .env. Integration points:
#   - HashiCorp Vault: set VAULT_ADDR + VAULT_TOKEN, secrets fetched at boot
#   - AWS Secrets Manager: set AWS_REGION + AWS_SECRETS_ID, secrets fetched at boot
VAULT_ADDR=
VAULT_TOKEN=
AWS_REGION=
AWS_SECRETS_ID=

# --- Deployment mode (Phase 6, Risk 2) ---
# cloud | onprem. onprem disables outbound telemetry and gates LLM calls behind
# DEVBOARD_LLM_ENDPOINT being a self-hosted model.
DEVBOARD_MODE=cloud
DEVBOARD_LLM_ENDPOINT=

# --- Misc ---
API_KEY_SALT=change-me-in-prod
LOG_LEVEL=info
